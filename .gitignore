# Operating System & IDE Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*~

# Release Signing Keystores (Proteksi Kunci Rilis untuk Repositori Publik)
# CATATAN: Simpan keystore secara privat atau gunakan GitHub Secrets untuk CI/CD
*.keystore
*.jks
android/release.keystore

# Build Outputs (Opsional jika binary rilis diunggah ke GitHub Releases)
# Al-Quran-Digital-Indonesia-Debug.apk

# Additional Android security exclusions
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/local.properties
android/release.keystore
**/key.properties
*.jks
*.keystore

# Build binaries
*.apk
*.aab

