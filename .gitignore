yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Antigravity & Scratch Development Workspace
scratch/
.gemini/
.system_generated/
*.log

# Project Backup Directories
_backup_*/

# Android & Gradle Build Artifacts
.gradle/
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/.idea/
android/*.iml
android/app/*.iml
android/captures/
android/.externalNativeBuild/
